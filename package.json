{
  "name": "bilibili-broadcast-list-script",
  "version": "3",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "description": "Standalone Bilibili page scripts for native PotPlayer BroadcastList injection",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node build.cjs",
    "build:release": "node build.cjs --release",
    "build:page": "node build.cjs --page",
    "build:debug": "node build.cjs --all-pages",
    "watch": "node build.cjs --watch",
    "check": "node build.cjs --check",
    "check:release": "node build.cjs --check --release",
    "release:prepare": "node release.cjs --prepare",
    "release:preview": "node release.cjs --preview",
    "release": "node release.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
